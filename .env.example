# Read by the Config node in workflows/ai-paper-digest.json.
# The Gemini API key and the Telegram bot token are NOT here - those live in
# n8n's credential store. These two are values the workflow reads directly.
#
# If your n8n denies env access in expressions (n8n Cloud always does, and
# self-hosted does when N8N_BLOCK_ENV_ACCESS_IN_NODE=true), skip this file and
# paste the values straight into the Config node instead. Note that the webhook
# URL then lives inside the workflow JSON, so do not export it to a public repo.

# Discord webhook URL. This is a credential in its own right: anyone holding
# it can post to the channel, and GitHub secret scanning does not catch it.
#   Server settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Telegram chat ID. Positive for a personal chat, negative for a group.
# NOT the digits before the colon in the bot token - that is the bot itself,
# and sending there fails with 403. Message the bot first, then read it from:
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates"
TELEGRAM_CHAT_ID=
