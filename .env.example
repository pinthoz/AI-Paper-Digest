# Read by the Config nodes in the workflows, and by docker-compose.yml.
# The Gemini API key and the Telegram bot token are NOT here - those live in
# n8n's credential store. These are the values read directly.
#
# If your n8n denies env access in expressions (n8n Cloud always does, and
# self-hosted does when N8N_BLOCK_ENV_ACCESS_IN_NODE=true), skip this file and
# paste the values straight into the Config node instead. Note that the webhook
# URL then lives inside the workflow JSON, so do not export it to a public repo.

# Discord webhook URL. This is a credential in its own right: anyone holding
# it can post to the channel, and GitHub secret scanning does not catch it.
#   Server settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Telegram chat ID. Positive for a personal chat, negative for a group.
# NOT the digits before the colon in the bot token - that is the bot itself,
# and sending there fails with 403. Message the bot first, then read it from:
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates"
TELEGRAM_CHAT_ID=

# --- the ranker service (docker compose) -------------------------------------

# Shared secret between n8n and the ranker. Both containers read this same
# variable, so a value that exists in only one of them reads as a 401 that
# looks like a bug. Any long random string; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave it empty and the endpoints are unauthenticated - fine on a laptop,
# not fine on anything with a public port.
RANKER_TOKEN=

# Discord BOT token, which is a different thing from the webhook above:
# webhooks write, bots read, and reactions have to be read. Only needed for
# workflows/feedback-sync.json; without it that workflow reports
# "not-configured" and everything else carries on.
#   Developer Portal -> your app -> Bot -> Reset Token
# It has two dots in it. A 64-character hex string is the Public Key, which is
# a different value and will authenticate as nothing.
DISCORD_BOT_TOKEN=

# --- container timezone ------------------------------------------------------
# The cron expressions are evaluated in the workflow's timezone; these keep the
# container's clock and n8n's default agreeing with it.
GENERIC_TIMEZONE=Europe/Lisbon
TZ=Europe/Lisbon
